# AI Prism — variáveis de ambiente para DESENVOLVIMENTO LOCAL (`npm run dev`).
#
# Em produção (Databricks App), o runtime injeta estas variáveis automaticamente
# via app.yaml + recursos do bundle — você NÃO precisa deste arquivo lá. Ele serve
# só para rodar o app fora do runtime da Databricks, na sua máquina.
#
# Copie para `.env` (que é git-ignored) e preencha. NUNCA commite segredos.
#   cp .env.example .env

# ── Workspace / AI Gateway ────────────────────────────────────────────────────
# Host do workspace Databricks (sem barra no final).
DATABRICKS_HOST=https://<seu-workspace>.cloud.databricks.com
# Sua identidade + token pessoal (PAT) para o AI Gateway e demais chamadas de API
# em dev local. No app deployado isso vem do OBO do usuário logado.
DATABRICKS_USER_EMAIL=voce@empresa.com
DATABRICKS_USER_TOKEN=dapi...

# ── SQL Warehouse (UC Functions + UDF Python) ─────────────────────────────────
# Id de um Serverless SQL Warehouse do seu workspace.
SQL_WAREHOUSE_ID=

# ── Lakebase (Postgres) ───────────────────────────────────────────────────────
# Em dev local defina o host diretamente (no app deployado vem do recurso
# `lakebase` via PG_ENDPOINT). O token de CLI do workspace NÃO é aceito pelo
# Lakebase — use uma credencial de banco dedicada como PGPASSWORD.
PGHOST=
PGPASSWORD=
# Opcionais — têm defaults sensatos no código/app.yaml:
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGSSLMODE=require

# ── Local do app / catálogos (opcionais — defaults em app.yaml e no código) ────
# PORT=8000
# DATABRICKS_APP_NAME=ai-prism
# TOOLS_CATALOG=ai_prism
# TOOLS_SCHEMA=default
# IMAGE_VOLUME_CATALOG=ai_prism
# IMAGE_VOLUME_SCHEMA=default
# IMAGE_VOLUME_NAME=ai_prism_images

# ── Admin / features (opcionais) ──────────────────────────────────────────────
# E-mail do admin bootstrap (no deploy o job semeia o deployer na tabela app_admins).
# APP_OWNER_EMAIL=voce@empresa.com
# Recuperação semântica do histórico (pgvector). Vazio/0 desliga.
# HISTORY_RETRIEVAL=1
# Grounding na web gerenciado pelo próprio Prism. Configure UMA fonte de busca;
# todos os usuários recebem `web_search` + `web_fetch`, sem conta individual.
# Prioridade: Brave central > SearXNG próprio > MCP legado.
# BRAVE_SEARCH_API_KEY=chave-central-do-deployment
# SEARXNG_URL=https://search.example.com
# WEB_SEARCH_CONNECTION=web_search_mcp
# Kill-switch operacional. Vazio/0 habilita quando uma fonte acima existe.
WEB_SEARCH_DISABLED=0

# ── Transcrição de áudio/vídeo (multimodal via Gemini no gateway) ─────────────
# TRANSCRIBE_MODEL=databricks-gemini-3-6-flash
# TRANSCRIBE_DISABLED=  # 1 desabilita e esconde o seletor de mídia
