# AI Prism — environment variables for LOCAL DEVELOPMENT (`npm run dev`).
#
# In production (Databricks App), the runtime injects these variables
# automatically via app.yaml + the bundle resources — you do NOT need this file
# there. It only exists to run the app outside the Databricks runtime, on your
# own machine.
#
# Copy it to `.env` (which is git-ignored) and fill it in. NEVER commit secrets.
#   cp .env.example .env

# ── Workspace / AI Gateway ────────────────────────────────────────────────────
# Databricks workspace host (no trailing slash).
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# Your identity + personal access token (PAT) for the AI Gateway and other API
# calls in local dev. In the deployed app this comes from the signed-in user's OBO.
DATABRICKS_USER_EMAIL=you@example.com
DATABRICKS_USER_TOKEN=dapi...

# ── SQL Warehouse (UC Functions + UDF Python) ─────────────────────────────────
# Id of a Serverless SQL Warehouse in your workspace.
SQL_WAREHOUSE_ID=

# ── Lakebase (Postgres) ───────────────────────────────────────────────────────
# In local dev set the host directly (in the deployed app it comes from the
# `lakebase` resource via PG_ENDPOINT). The workspace CLI token is NOT accepted by
# Lakebase — use a dedicated database credential as PGPASSWORD.
PGHOST=
PGPASSWORD=
# Optional — sensible defaults in the code/app.yaml:
# PGPORT=5432
# PGDATABASE=databricks_postgres
# PGSSLMODE=require
# Postgres TLS: always encrypted; the chain is only VERIFIED with one of these.
#   PG_SSL_VERIFY=1    verify the chain (Node trust store, or the CA below)
#   PG_SSL_CA=         CA PEM (inline or file path); turns verification on
#   PG_SSL_VERIFY=0    turn verification off even with PG_SSL_CA (diagnostics)
# PG_SSL_REJECT_UNAUTHORIZED is still accepted as the old alias of PG_SSL_VERIFY.
# PG_SSL_VERIFY=
# PG_SSL_CA=
# Schema migrations: the app applies pending ones at boot. The tables live in the
# dedicated `ai_prism` schema (migration 0002). The same PG* variables above serve
# the CLI (as the table owner; see docs/operations.md §6.4), one command at a time:
#   node --env-file=.env.local scripts/migrate.mjs status
#   node --env-file=.env.local scripts/migrate.mjs up
#   node --env-file=.env.local scripts/migrate.mjs down --to N --yes
#   node --env-file=.env.local scripts/migrate.mjs grants --role <service principal client id>
# `down --to 0` drops every table: test databases only.

# ── App port / catalogs (optional — defaults in app.yaml and the code) ────────
# PORT=8000
# DATABRICKS_APP_NAME=ai-prism
# TOOLS_CATALOG=ai_prism
# TOOLS_SCHEMA=default
# IMAGE_VOLUME_CATALOG=ai_prism
# IMAGE_VOLUME_SCHEMA=default
# IMAGE_VOLUME_NAME=ai_prism_images

# ── Admin / features (optional) ───────────────────────────────────────────────
# Bootstrap admin e-mail (on deploy the job seeds the deployer into app_admins).
# APP_OWNER_EMAIL=you@example.com
# Semantic history retrieval (pgvector). Empty/0 turns it off.
# HISTORY_RETRIEVAL=1
# Web grounding managed by Prism itself. Configure ONE search source; every user
# gets `web_search` + `web_fetch`, with no individual account.
# Priority: central Brave > your own SearXNG > legacy MCP.
# BRAVE_SEARCH_API_KEY=central-deployment-key
# SEARXNG_URL=https://search.example.com
# WEB_SEARCH_CONNECTION=web_search_mcp
# Operational kill switch. Empty/0 enables it when a source above exists.
WEB_SEARCH_DISABLED=0

# ── Audio/video transcription (multimodal via Gemini on the gateway) ──────────
# TRANSCRIBE_MODEL=databricks-gemini-3-6-flash
# TRANSCRIBE_DISABLED=  # 1 disables it and hides the media picker
