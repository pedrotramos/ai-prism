# OPTIONAL (recommended): the admin audit hash key — docs/security-threat-model.md G8.
#
# The admin audit trail (admin_audit) stores the acting admin, and admin targets,
# as a hash of the e-mail. With this key the hash is 'h2:' + HMAC-SHA256 of the
# lowercased e-mail, so nobody without the key can reverse it with a dictionary of
# e-mails. Without it the app uses the legacy unsalted hash and logs one warning at
# boot. To turn it on:
#
#   1. databricks secrets create-scope ai-prism-audit -p <PROFILE>
#      databricks secrets put-secret ai-prism-audit audit-hash-key -p <PROFILE>
#      (a long random value, e.g. 32+ bytes from a password manager; never commit it)
#   2. cp bundle/optional/audit-hash-key-secret.yml.example bundle/optional/audit-hash-key-secret.yml
#      (databricks.yml includes bundle/optional/*.yml; this .example is not matched)
#   3. deploy with the variables, e.g.
#      databricks bundle deploy -p <PROFILE> -t dev \
#        --var audit_hash_key_scope=ai-prism-audit --var audit_hash_key_name=audit-hash-key
#   4. uncomment APP_AUDIT_HASH_KEY with `valueFrom: 'audit-hash-key'` in app.yaml and
#      redeploy.
#
# Keep the same key across deploys: rows hashed with an earlier key (or the legacy
# scheme, no 'h2:' prefix) stay as they are and no longer match new hashes of the
# same e-mail. The app's service principal gets READ on that one secret; the value
# reaches the app only as an environment variable and is never logged.
variables:
  audit_hash_key_scope:
    description: Secret scope holding the admin audit hash key.
  audit_hash_key_name:
    description: Key, inside audit_hash_key_scope, of the admin audit hash key.

targets:
  dev:
    resources:
      apps:
        ai_prism:
          resources:
            - name: audit-hash-key
              secret:
                scope: ${var.audit_hash_key_scope}
                key: ${var.audit_hash_key_name}
                permission: READ
  prod:
    resources:
      apps:
        ai_prism:
          resources:
            - name: audit-hash-key
              secret:
                scope: ${var.audit_hash_key_scope}
                key: ${var.audit_hash_key_name}
                permission: READ
