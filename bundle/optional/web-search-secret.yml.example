# OPTIONAL: keyed web search fallback (Brave or Tavily) — docs/web-search.md.
#
# Web search is MCP-first: the managed `system.ai.web_search` and an external
# MCP Service (WEB_SEARCH_MCP_SERVICE in app.yaml) keep the provider key in a
# Unity Catalog connection and need nothing here. Only a KEYED fallback needs a
# secret in the app. To turn it on:
#
#   1. databricks secrets create-scope ai-prism-web-search -p <PROFILE>
#      databricks secrets put-secret ai-prism-web-search brave-api-key -p <PROFILE>
#   2. cp bundle/optional/web-search-secret.yml.example bundle/optional/web-search-secret.yml
#      (databricks.yml includes bundle/optional/*.yml; this .example is not matched)
#   3. deploy with the variables, e.g.
#      databricks bundle deploy -p <PROFILE> -t dev \
#        --var web_search_secret_scope=ai-prism-web-search --var web_search_secret_key=brave-api-key
#   4. uncomment BRAVE_SEARCH_API_KEY (or TAVILY_API_KEY) with `valueFrom: 'web-search-key'`
#      in app.yaml and redeploy.
#
# The app's service principal gets READ on that one secret; the value reaches the
# app only as an environment variable, is never logged and is never shown (the
# admin status reports presence only).
variables:
  web_search_secret_scope:
    description: Secret scope holding the keyed web search provider key (Brave or Tavily).
  web_search_secret_key:
    description: Key, inside web_search_secret_scope, of the provider key.

targets:
  dev:
    resources:
      apps:
        ai_prism:
          resources:
            - name: web-search-key
              secret:
                scope: ${var.web_search_secret_scope}
                key: ${var.web_search_secret_key}
                permission: READ
  prod:
    resources:
      apps:
        ai_prism:
          resources:
            - name: web-search-key
              secret:
                scope: ${var.web_search_secret_scope}
                key: ${var.web_search_secret_key}
                permission: READ
