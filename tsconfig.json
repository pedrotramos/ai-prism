{
  // TypeScript by ownership (docs/adr/0006-typescript.md): a file you own and
  // materially edit becomes `.ts`, with a one-line `.js` re-export shim so its
  // importers keep their specifiers. `strict` and the options below apply to
  // `.ts` files only: `allowJs` lets tsc parse the remaining JavaScript, and
  // `checkJs` stays off so JS keeps building unchanged while it migrates.
  //
  // `.ts` must use only erasable syntax (no enum, namespace, parameter
  // properties): Node 22.18+ runs it in dev by stripping the types, and
  // esbuild (server bundle) / Vite (client) compile it for production.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["server", "shared", "client/src", "scripts/appkit"],
  "exclude": ["node_modules", "server-dist", "client/dist"]
}
