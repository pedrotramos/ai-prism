{
  "datasets": [
    {
      "name": "ops_daily",
      "displayName": "AI Prism — operação · dia × endpoint",
      "queryLines": [
        "SELECT\n",
        "  date(eu.request_time) AS day,\n",
        "  se.endpoint_name AS endpoint_name,\n",
        "  COUNT(*) AS calls,\n",
        "  SUM(eu.input_token_count) AS prompt_tokens,\n",
        "  SUM(eu.output_token_count) AS completion_tokens,\n",
        "  SUM(eu.input_token_count + eu.output_token_count) AS total_tokens\n",
        "FROM\n",
        "  system.serving.endpoint_usage eu\n",
        "    JOIN system.serving.served_entities se\n",
        "      ON eu.served_entity_id = se.served_entity_id\n",
        "WHERE\n",
        "  eu.usage_context['application'] = 'ai-prism'\n",
        "  AND se.endpoint_name IS NOT NULL\n",
        "  AND date(eu.request_time) >= date_add(current_date(), -90)\n",
        "GROUP BY\n",
        "  1,\n",
        "  2"
      ]
    },
    {
      "name": "ops_user",
      "displayName": "AI Prism — operação · usuário × dia",
      "queryLines": [
        "SELECT\n",
        "  date(eu.request_time) AS day,\n",
        "  lower(eu.requester) AS user_email,\n",
        "  COUNT(*) AS calls,\n",
        "  SUM(eu.input_token_count + eu.output_token_count) AS total_tokens\n",
        "FROM\n",
        "  system.serving.endpoint_usage eu\n",
        "WHERE\n",
        "  eu.usage_context['application'] = 'ai-prism'\n",
        "  AND date(eu.request_time) >= date_add(current_date(), -90)\n",
        "GROUP BY\n",
        "  1,\n",
        "  2"
      ]
    },
    {
      "name": "ops_latency",
      "displayName": "AI Prism — operação · latência do gateway × dia × endpoint",
      "queryLines": [
        "SELECT\n",
        "  date(eu.request_time) AS day,\n",
        "  se.endpoint_name AS endpoint_name,\n",
        "  percentile_approx(g.latency_ms, 0.5) AS latency_p50_ms,\n",
        "  percentile_approx(g.latency_ms, 0.95) AS latency_p95_ms,\n",
        "  COUNT(g.request_id) AS sample_size\n",
        "FROM\n",
        "  system.serving.endpoint_usage eu\n",
        "    JOIN system.serving.served_entities se\n",
        "      ON eu.served_entity_id = se.served_entity_id\n",
        "    JOIN system.ai_gateway.usage g\n",
        "      ON g.request_id = eu.databricks_request_id\n",
        "WHERE\n",
        "  eu.usage_context['application'] = 'ai-prism'\n",
        "  AND se.endpoint_name IS NOT NULL\n",
        "  AND date(eu.request_time) >= date_add(current_date(), -90)\n",
        "GROUP BY\n",
        "  1,\n",
        "  2"
      ]
    }
  ],
