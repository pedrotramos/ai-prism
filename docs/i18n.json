{
  "$comment": "Docs i18n manifest, read by scripts/check-docs-i18n.mjs. English is canonical; see docs/README.md#translations.",
  "sourceLocale": "en",
  "names": {
    "en": "English",
    "pt-BR": "Português (Brasil)",
    "es": "Español"
  },
  "locales": [
    "pt-BR",
    "es"
  ],
  "sources": [
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/*.md",
    "dashboards/README.md"
  ],
  "exclude": [
    "docs/glossary.md",
    "docs/i18n-status.md",
    "docs/custos-e-posicionamento.md"
  ],
  "required": [
    "README.md",
    "SECURITY.md",
    "docs/README.md",
    "docs/costs-and-positioning.md",
    "docs/onboarding-deployment.md",
    "docs/security-faq.md"
  ],
  "paths": {
    "README.md": {
      "pt-BR": "README.pt-BR.md",
      "es": "README.es.md"
    },
    "dashboards/README.md": "docs/{locale}/dashboards/README.md"
  },
  "allowMissing": {
    "pt-BR": [
      "docs/ui-tokens.md"
    ],
    "es": [
      "docs/ui-tokens.md"
    ]
  },
  "notes": {
    "docs/ui-tokens.md": "Phase C (P2)"
  },
  "linkCheck": [
    "docs/glossary.md",
    "docs/i18n-status.md",
    "docs/custos-e-posicionamento.md",
    "docs/pt-BR/.llm-prompt.md",
    "docs/es/.llm-prompt.md"
  ],
  "status": "docs/i18n-status.md",
  "glossary": {
    "catalogs": "client/src/lib/locales/index.js",
    "catalogLocales": {
      "en": "en",
      "pt-BR": "pt",
      "es": "es"
    },
    "keys": "docs/glossary.keys.json",
    "out": "docs/glossary.md"
  },
  "prohibited": {
    "$comment": "Names that must never appear in this repository, as salted SHA-256 entries made by `node scripts/check-docs-i18n.mjs --hash-terms <private file outside the repo>`. Never write the names themselves anywhere in the repo. DOCS_PROHIBITED_TERMS adds terms at run time. With --ci an empty list fails.",
    "salt": "4340fd11963fa91cb51551fdc5adbbc2",
    "terms": [
      {
        "length": 18,
        "sha256": "3e4c270d2758d0a9440f26d803c8b9d17b5626cd52e0cfa8dedff49ddb424f18"
      },
      {
        "length": 18,
        "sha256": "3e4c270d2758d0a9440f26d803c8b9d17b5626cd52e0cfa8dedff49ddb424f18"
      },
      {
        "length": 18,
        "sha256": "3e4c270d2758d0a9440f26d803c8b9d17b5626cd52e0cfa8dedff49ddb424f18"
      }
    ]
  }
}
